### Order Management Requests

# Variables
@baseUrl = http://localhost:3001/api
@orderId = order-id-here
@productId = product-id-here

### Get all orders
GET {{baseUrl}}/orders

### Get all orders with query parameters
GET {{baseUrl}}/orders?status=PENDING&limit=10&page=1

### Get order by ID
GET {{baseUrl}}/orders/{{orderId}}

### Create simple order
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "customerName": "John Doe",
  "tableNumber": 5,
  "products": [
    {
      "productId": "{{productId}}",
      "quantity": 2,
      "specialInstructions": "No onions please"
    }
  ],
  "status": "PENDING"
}

### Create complex order with payment info
POST {{baseUrl}}/orders
Content-Type: application/json

{
  "customerName": "Jane Smith",
  "tableNumber": 12,
  "products": [
    {
      "productId": "{{productId}}",
      "quantity": 1,
      "specialInstructions": "Extra cheese",
      "toppings": ["extra-cheese", "pepperoni"]
    },
    {
      "productId": "{{productId}}",
      "quantity": 2,
      "specialInstructions": "No ice"
    }
  ],
  "subtotal": 25.98,
  "tax": 2.60,
  "total": 28.58,
  "tip": 5.00,
  "paymentMethod": "CREDIT_CARD",
  "status": "PENDING"
}

### Update order status
PUT {{baseUrl}}/orders/{{orderId}}
Content-Type: application/json

{
  "status": "PREPARING"
}

### Update complete order
PUT {{baseUrl}}/orders/{{orderId}}
Content-Type: application/json

{
  "status": "COMPLETED",
  "customerName": "Updated Customer Name",
  "tableNumber": 8,
  "subtotal": 30.00,
  "tax": 3.00,
  "total": 33.00,
  "tip": 6.60,
  "paymentMethod": "CASH"
}

### Delete order (soft delete)
DELETE {{baseUrl}}/orders/{{orderId}} 