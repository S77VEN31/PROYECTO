{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "declaration": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["./*"]
    },
    "rootDir": ".",
    "lib": ["ES2020", "DOM"]
  },
  "include": ["**/*.ts", "**/*.d.ts", "index.ts"],
  "exclude": ["node_modules", "dist"]
} 