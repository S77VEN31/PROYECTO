{
  "name": "colori-platform-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "build:shared": "cd shared && yarn build",
    "build:backend": "cd backend && yarn build",
    "build:frontend": "cd frontend && yarn build",
    "build": "yarn build:shared && yarn build:backend && yarn build:frontend",
    "dev:backend": "cd backend && yarn dev",
    "dev:frontend": "cd frontend && yarn dev:legacy",
    "dev": "concurrently \"yarn dev:backend\" \"yarn dev:frontend\"",
    "install:all": "yarn install && cd shared && yarn install && cd ../backend && yarn install && cd ../frontend && yarn install",
    "clean": "rm -rf shared/dist backend/dist frontend/.next"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
